<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#2196F3" />

    <!-- Custom Toolbar -->
    <RelativeLayout
        android:id="@+id/customToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvSubjectTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Matematika"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="0/0"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            tools:ignore="HardcodedText" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/customToolbar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="40dp">

            <ProgressBar
                android:id="@+id/quizProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:progressDrawable="@drawable/custom_progress_bar" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="180dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/ivGambarSoalUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="15dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="Gambar Soal"
                        tools:visibility="visible"
                        tools:src="@android:drawable/ic_menu_gallery" />

                    <TextView
                        android:id="@+id/tvQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Memuat pertanyaan..."
                        android:textColor="#1E293B"
                        android:textSize="18sp"
                        android:textAlignment="center"
                        android:lineSpacingExtra="6dp"
                        android:fontFamily="sans-serif-medium"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpt1"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp"
                    android:textAllCaps="false"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textAlignment="textStart"
                    android:paddingHorizontal="20dp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="16dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1.5dp"
                    tools:text="Opsi A" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpt2"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp"
                    android:textAllCaps="false"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textAlignment="textStart"
                    android:paddingHorizontal="20dp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="16dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1.5dp"
                    tools:text="Opsi B" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpt3"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp"
                    android:textAllCaps="false"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textAlignment="textStart"
                    android:paddingHorizontal="20dp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="16dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1.5dp"
                    tools:text="Opsi C" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpt4"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp"
                    android:textAllCaps="false"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textAlignment="textStart"
                    android:paddingHorizontal="20dp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="16dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1.5dp"
                    tools:text="Opsi D" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpt5"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:textAllCaps="false"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textAlignment="textStart"
                    android:paddingHorizontal="20dp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="16dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1.5dp"
                    tools:text="Opsi E" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
