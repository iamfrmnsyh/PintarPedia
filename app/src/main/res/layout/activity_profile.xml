<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:ignore="HardcodedText,ContentDescription">

    <!-- Header Background -->
    <View
        android:id="@+id/viewHeaderBg"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#2196F3" />

    <!-- Custom Toolbar -->
    <RelativeLayout
        android:id="@+id/customToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Akun Saya"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/customToolbar"
        android:clipToPadding="false"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Profile Info Section -->

            <!-- Personal Information Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="1dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/white"
                    app:strokeWidth="4dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profileImage"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/profile_placeholder"
                        app:shapeAppearanceOverlay="@style/CircleImage" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvNamaHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Memuat Nama..."
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvIdUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:letterSpacing="0.05"
                    android:text="ID: #12345"
                    android:textColor="#E0E7FF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="25dp"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:text="Informasi Pribadi"
                android:textAllCaps="true"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <!-- Username Row -->
                    <LinearLayout style="@style/Widget.PintarPedia.ProfileRow">
                        <ImageView
                            style="@style/Widget.PintarPedia.ProfileIcon"
                            android:src="@drawable/ic_person" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">
                            <TextView style="@style/Widget.PintarPedia.LabelProfile" android:text="Nama Pengguna" />
                            <TextView android:id="@+id/tvUsernameDetail" style="@style/Widget.PintarPedia.ValueProfile" android:text="Nama Pengguna" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginStart="56dp" />

                    <!-- Phone Row -->
                    <LinearLayout style="@style/Widget.PintarPedia.ProfileRow">
                        <ImageView
                            style="@style/Widget.PintarPedia.ProfileIcon"
                            android:src="@drawable/ic_phone" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">
                            <TextView style="@style/Widget.PintarPedia.LabelProfile" android:text="Nomor Telepon" />
                            <TextView android:id="@+id/tvPhone" style="@style/Widget.PintarPedia.ValueProfile" android:text="-" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginStart="56dp" />

                    <!-- Email Row -->
                    <LinearLayout style="@style/Widget.PintarPedia.ProfileRow">
                        <ImageView
                            style="@style/Widget.PintarPedia.ProfileIcon"
                            android:src="@drawable/ic_email" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">
                            <TextView style="@style/Widget.PintarPedia.LabelProfile" android:text="Akun" />
                            <TextView android:id="@+id/tvEmailDetail" style="@style/Widget.PintarPedia.ValueProfile" android:text="-" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengaturan"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#64748B"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btnEditProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="Edit Informasi Pribadi"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:drawablePadding="16dp"
                        android:background="?attr/selectableItemBackground"
                        app:drawableStartCompat="@drawable/ic_edit"
                        app:drawableTint="#2196F3" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" android:layout_marginHorizontal="16dp" />

                    <TextView
                        android:id="@+id/btnUbahPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="Ganti Kata Sandi"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:drawablePadding="16dp"
                        android:background="?attr/selectableItemBackground"
                        app:drawableStartCompat="@drawable/ic_lock"
                        app:drawableTint="#2196F3" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Keluar Akun"
                android:textColor="#EF4444"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="20dp"
                android:backgroundTint="#FEE2E2"
                app:elevation="0dp"
                app:rippleColor="#10EF4444"
                app:strokeWidth="1dp"
                app:strokeColor="#FCA5A5" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
