<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah &amp; Kelola Soal"
            android:textColor="#1E293B"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manajemen Database Soal PintarPedia"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginBottom="28dp" />

        <!-- BAGIAN 1: PENGATURAN KATEGORI -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kategori Tahun / Paket"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#1E293B"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:letterSpacing="0.05" />

                <Spinner
                    android:id="@+id/spinnerKategori"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@android:drawable/btn_dropdown" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BAGIAN 3: INPUT BULK -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload Masal (Bulk)"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#F4B400"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paste teks soal di bawah ini."
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:layout_marginBottom="20dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeColor="#F4B400">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBulkSoal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Format: Pertanyaan, Opsi, Jawaban"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:gravity="top"
                        android:textColor="#1E293B" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadBulk"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Upload Teks Masal"
                    android:fontFamily="sans-serif-black"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    android:backgroundTint="#F4B400"
                    app:elevation="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BAGIAN 4: UPLOAD FILE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Import dari File (.TXT)"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#10B981"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih file dokumen .txt untuk mengimpor banyak soal sekaligus."
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:layout_marginBottom="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChooseFile"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Pilih File (.txt)"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:strokeColor="#10B981"
                    app:icon="@drawable/ic_book"
                    app:iconGravity="textStart"
                    app:iconTint="#10B981"
                    android:textColor="#10B981" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
